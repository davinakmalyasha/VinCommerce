# --- Go ---
backend/bin/
backend/tmp/
*.test
*.out
coverage.html

# --- Node / web ---
# Any depth, not just web/: the vitest results cache under node_modules/ got
# committed once because this said `web/node_modules/` and the cache lives at the
# repo root. Dependency trees are never reviewed, so they are never committed.
node_modules/
web/dist/
web/test-results/
web/playwright-report/
web/.env
*.local

# --- Binaries & runtime data ---
*.exe
*.exe~
backend/data/
uploads/

# --- Env & secrets ---
.env
.env.*
!.env.example

# --- Tooling ---
*.log
.DS_Store
Thumbs.db
.vscode/
.idea/

# --- Local data ---
infra/data/

# mutation-check writes a source backup here while a file is mutated, and removes it
# after restoring. A run killed mid-test leaves both behind; the next run recovers from
# them, so a stray copy in the tree is a bug, not a working state.
.mutation-backup/

# vitest coverage output -- generated by the coverage script, never reviewed
web/coverage/
coverage/
__pycache__/
*.pyc
