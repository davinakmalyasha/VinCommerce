# web/.env.example
#
# Every VITE_-prefixed variable the app reads (grep `import.meta.env` across
# web/src). Vite inlines these into the bundle at BUILD time, so changing one
# requires a rebuild, not just a container restart.
#
# The VITE_ prefix means "exposed to the browser". Anything listed here is
# public the moment the site loads. Never add a VITE_-prefixed name that holds
# a secret — that is what the un-prefixed backend config is for.

# API base URL the app calls. Empty means same-origin, which is what you want
# behind the nginx reverse proxy in infra/compose/compose.full.yaml (nginx
# forwards /api to the api container). Set it only when the API lives on a
# different origin from the SPA.
#
# This IS honoured: lib/api.ts uses it for the axios baseURL. It was documented
# here as the API base while api.ts hardcoded '/api/v1' and ignored it entirely,
# so an operator who set it to a cross-origin API had configured nothing.
VITE_API_URL=

# Where the Swagger UI and the OpenAPI document live.
#
# /api-docs, not /docs. The SPA owns a /docs route and a /docs/api quickstart
# page, and nginx used to proxy /docs to the API, which made both unreachable
# behind the edge. Set this to a same-origin value in production (nginx now
# proxies /api-docs), or to the API origin in local development where the two
# run on different ports.
VITE_API_DOCS_URL=http://localhost:8080/api-docs

# Midtrans Snap client key. This is a PUBLISHABLE key (the matching
# MIDTRANS_SERVER_KEY stays in the backend env and must never appear here).
# Left empty, payWithSnap() is disabled and checkout falls back to the
# in-app "transfer manual" flow — which is the correct default.
#
# In a container build this must be passed as a build arg, because Vite bakes
# it into the bundle:
#   docker compose build --build-arg VITE_MIDTRANS_CLIENT_KEY=...
# or in the api compose stack, `VITE_MIDTRANS_CLIENT_KEY` in the web service's
# `build.args`.
VITE_MIDTRANS_CLIENT_KEY=

# Midtrans Snap script URL. Sandbox by default; set to
# https://app.midtrans.com/snap/snap.js for production.
VITE_MIDTRANS_SNAP_URL=https://app.sandbox.midtrans.com/snap/snap.js
