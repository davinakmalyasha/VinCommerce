# --- VinCommerce API ---
APP_ENV=development
PORT=8080
SHUTDOWN_GAP=10s

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=vincom
DB_PASSWORD=vincom_dev
DB_NAME=vincom
DB_SSL_MODE=disable
DB_MAX_CONNS=20
DB_MIN_CONNS=2
DB_MAX_IDLE=5m
DB_MAX_LIFE=30m
DB_MIGRATE_ON_START=true

# Redis
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=0

# Auth (development only — override in production)
JWT_SECRET=dev-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h

# App
APP_BASE_URL=http://localhost:8080
WEB_URL=http://localhost:5173
CORS_ALLOW_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads
